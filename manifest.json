{
  "manifest_version": 3,
  "name": "YouTube Comment Analyzer",
  "version": "1.0",
  "description": "Analyzes the sentiment of YouTube comments using ML and the official API.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "http://ec2-13-60-62-210.eu-north-1.compute.amazonaws.com/*",
    "https://www.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}